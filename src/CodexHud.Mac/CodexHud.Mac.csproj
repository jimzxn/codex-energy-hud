<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodexHud.Mac</AssemblyName>
    <Version>1.7.3</Version>
    <Description>Codex quota and hardware HUD for macOS</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexHud.Core/CodexHud.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <AvaloniaResource Include="../CodexHud/Assets/app.ico" Link="Assets/app.ico" />
  </ItemGroup>
</Project>
