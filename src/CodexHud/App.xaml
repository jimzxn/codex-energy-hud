<Application x:Class="CodexHud.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#DDEC63" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F1F3EC" />
    <SolidColorBrush x:Key="TextMuted" Color="#909B98" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#4052554A" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25474F43"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="ControlTrack" Color="#303D32"/>
    <SolidColorBrush x:Key="ControlThumb" Color="#7C8B59"/>
    <SolidColorBrush x:Key="ControlSurface" Color="#18221B"/>

    <!-- The entire 14 DIP lane is interactive; only its center is painted. -->
    <Style x:Key="HudScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{StaticResource ControlThumb}"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" Margin="4,1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="ThumbSurface" Property="Margin" Value="3,1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbSurface" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="HudHorizontalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource HudScrollThumb}">
      <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="24"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent"><Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" Margin="1,4"/></Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="ThumbSurface" Property="Margin" Value="1,3"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbSurface" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="HudScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HudScrollLineButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource ControlThumb}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="LineButtonSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="LineButtonSurface" Property="Background" Value="#253426"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LineButtonSurface" Property="Background" Value="#405137"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LineButtonSurface" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="HudVerticalScrollBarTemplate" TargetType="ScrollBar">
      <Grid Background="{TemplateBinding Background}">
        <Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/></Grid.RowDefinitions>
        <RepeatButton Style="{StaticResource HudScrollLineButton}" Command="{x:Static ScrollBar.LineUpCommand}" AutomationProperties.Name="向上滚动">
          <Path Data="M 0,3 L 3,0 6,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" StrokeThickness="1"/>
        </RepeatButton>
        <Border Grid.Row="1" Width="2" Background="{StaticResource ControlTrack}" HorizontalAlignment="Center"/>
        <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource HudScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource HudScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource HudScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
        </Track>
        <RepeatButton Grid.Row="2" Style="{StaticResource HudScrollLineButton}" Command="{x:Static ScrollBar.LineDownCommand}" AutomationProperties.Name="向下滚动">
          <Path Data="M 0,0 L 3,3 6,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" StrokeThickness="1"/>
        </RepeatButton>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HudHorizontalScrollBarTemplate" TargetType="ScrollBar">
      <Grid Background="{TemplateBinding Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
        <RepeatButton Style="{StaticResource HudScrollLineButton}" Command="{x:Static ScrollBar.LineLeftCommand}" AutomationProperties.Name="向左滚动">
          <Path Data="M 3,0 L 0,3 3,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" StrokeThickness="1"/>
        </RepeatButton>
        <Border Grid.Column="1" Height="2" Background="{StaticResource ControlTrack}" VerticalAlignment="Center"/>
        <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource HudScrollPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource HudHorizontalScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource HudScrollPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
        </Track>
        <RepeatButton Grid.Column="2" Style="{StaticResource HudScrollLineButton}" Command="{x:Static ScrollBar.LineRightCommand}" AutomationProperties.Name="向右滚动">
          <Path Data="M 0,0 L 3,3 0,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" StrokeThickness="1"/>
        </RepeatButton>
      </Grid>
    </ControlTemplate>
    <Style x:Key="HudScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="14"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template" Value="{StaticResource HudVerticalScrollBarTemplate}"/>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="Template" Value="{StaticResource HudHorizontalScrollBarTemplate}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HudScrollBar}"/>
    <Style x:Key="HudScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" AutomationProperties.Name="垂直滚动"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" AutomationProperties.Name="水平滚动"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource HudScrollViewer}"/>

    <Style x:Key="HudCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="{StaticResource ControlSurface}"/>
      <Setter Property="BorderBrush" Value="#687655"/><Setter Property="Margin" Value="0,6"/><Setter Property="MinHeight" Value="24"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="CheckSurface" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left">
              <Path x:Name="CheckOutline" Data="M 1,1 L 12,1 17,6 17,17 1,17 Z" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
              <Path x:Name="CheckMark" Data="M 4,9 L 7,12 13,5" Stroke="{StaticResource Accent}" StrokeThickness="2" Visibility="Collapsed"/>
              <Path x:Name="IndeterminateMark" Data="M 5,9 L 13,9" Stroke="{StaticResource Accent}" StrokeThickness="2" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            <Rectangle x:Name="CheckFocus" Grid.ColumnSpan="2" Margin="-3" Stroke="{StaticResource Accent}" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckOutline" Property="Fill" Value="#303D27"/><Setter TargetName="CheckOutline" Property="Stroke" Value="{StaticResource ControlThumb}"/></Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckOutline" Property="Stroke" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckOutline" Property="Fill" Value="#435133"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckSurface" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource HudCheckBox}"/>

    <Style x:Key="HudSliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="24"/><Setter Property="Background" Value="{StaticResource ControlThumb}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Path x:Name="SliderThumbSurface" Data="M 2,5 L 9,5 12,8 12,19 2,19 Z" Fill="{TemplateBinding Background}" Stroke="#B3C184" StrokeThickness="1"/>
            <Path Data="M 6,9 L 6,15" Stroke="#243221" StrokeThickness="1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SliderThumbSurface" Property="Fill" Value="{StaticResource Accent}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="SliderThumbSurface" Property="Fill" Value="{StaticResource Accent}"/><Setter TargetName="SliderThumbSurface" Property="Stroke" Value="{StaticResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="HudSliderPageButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="{StaticResource ControlTrack}"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HudVerticalSliderPageButton" TargetType="RepeatButton" BasedOn="{StaticResource HudSliderPageButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Width="3" HorizontalAlignment="Center" Background="{TemplateBinding Background}"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="HudHorizontalSliderTemplate" TargetType="Slider">
      <Grid x:Name="SliderSurface" Background="Transparent" MinHeight="26">
        <Track x:Name="PART_Track" VerticalAlignment="Center" Height="24" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource HudSliderPageButton}" Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource ControlThumb}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="SliderThumb" Style="{StaticResource HudSliderThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource HudSliderPageButton}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
        </Track>
        <Rectangle x:Name="SliderFocus" Stroke="{StaticResource Accent}" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderFocus" Property="Visibility" Value="Visible"/><Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderSurface" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="HudVerticalSliderTemplate" TargetType="Slider">
      <Grid x:Name="SliderSurface" Background="Transparent" MinWidth="26">
        <Track x:Name="PART_Track" HorizontalAlignment="Center" Width="24" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource HudVerticalSliderPageButton}" Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource ControlThumb}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="SliderThumb" Style="{StaticResource HudSliderThumb}"><Thumb.LayoutTransform><RotateTransform Angle="90"/></Thumb.LayoutTransform></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource HudVerticalSliderPageButton}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
        </Track>
        <Rectangle x:Name="SliderFocus" Stroke="{StaticResource Accent}" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderFocus" Property="Visibility" Value="Visible"/><Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderSurface" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HudSlider" TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template" Value="{StaticResource HudHorizontalSliderTemplate}"/>
      <Style.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter Property="Template" Value="{StaticResource HudVerticalSliderTemplate}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource HudSlider}"/>

    <Style TargetType="ToolTip"><Setter Property="Background" Value="#202722"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="#536047"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style x:Key="HudListBoxItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid x:Name="ItemRoot">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <Rectangle x:Name="SelectionMarker" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
            <Rectangle x:Name="ItemFocus" Margin="3" Stroke="#94A16D" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#233027"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#445345"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#30402D"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#637541"/><Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemFocus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemRoot" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource HudListBoxItem}"/>
  </Application.Resources>
</Application>
